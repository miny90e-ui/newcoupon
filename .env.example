# PostgreSQL connection string
DATABASE_URL="postgresql://newcoupon:CHANGE_ME@localhost:5432/newcoupon?schema=public"

# Public URL of the site, no trailing slash (used for SEO / sitemap)
SITE_URL="https://newcoupon.com"

# Long random string for signing login sessions: run `openssl rand -base64 48`
AUTH_SECRET="CHANGE_ME"

# The first admin account, created by `npm run db:seed`
ADMIN_EMAIL="admin@newcoupon.com"
ADMIN_PASSWORD="CHANGE_ME"

# Set to "true" to also seed a few sample stores and coupons
SEED_SAMPLE="false"

# Where uploaded logos and banners are stored (absolute path on the server)
UPLOAD_DIR="./uploads"

# Contact email shown on the Contact page
CONTACT_EMAIL="hello@newcoupon.com"
